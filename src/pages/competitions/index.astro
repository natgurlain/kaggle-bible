---
import SiteNav from '../../components/SiteNav.astro';
import PublishedLibrary from '../../components/PublishedLibrary.astro';
import manifest from '../../../data/competition-inventory.manifest.json';
import catalog from '../../../public/data/competition-catalog.json';
import { getCatalogCardPresentation } from '../../content/catalog-policy.js';
const publishedRows = catalog.filter(row => getCatalogCardPresentation(row).guideHref !== null);
const categories = [...new Set(catalog.map(row => row.category).filter(Boolean))].sort();
const catalogAsset = '/data/competition-discovery.json';
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/x-icon" href="https://www.kaggle.com/static/images/favicon.ico" />
		<title>Competition catalog · Kaggle Bible</title>
		<script is:inline>
			const loadingParams = new URLSearchParams(location.search);
			if (loadingParams.get('view') === 'all') {
				document.documentElement.dataset.archivePending = '';
			}
		</script>
		<meta
			name="description"
			content="Browse the Kaggle Bible competition catalog by task, metric, status, and guide completeness."
		/>
	</head>
	<body>
		<SiteNav />
		<main id="main-content" tabindex="-1" class="catalog-shell" data-catalog-asset={catalogAsset}>
			<header class="catalog-header">
				<a class="back-link" href="/">← Kaggle Bible</a>
				<p class="eyebrow">Browse the archive</p>
				<h1>Competition catalog</h1>
				<p class="lede">
					Find a competition to study, practice on, or add to the editorial queue. The catalog includes
					all competitions in the dated Meta Kaggle snapshot; a row marked catalog has not yet received a
					Kaggle Bible guide.
				</p>
			</header>

			<section class="controls" aria-labelledby="filter-heading">
				<nav aria-label="Catalog view"><a id="guide-view" href="/competitions/" aria-current="page">Available guides</a> · <a id="archive-view" href="/competitions/?view=all">Search all competitions in the archive</a></nav>
				<h2 id="filter-heading">Filter the catalog</h2>
				<div class="control-grid">
					<label>
						<span>Search</span>
						<input id="query" type="search" placeholder="Title, slug, or metric" autocomplete="off" />
					</label>
					<label>
						<span>Category</span>
						<select id="category">
							<option value="">All categories</option>
							{categories.map(category => <option value={category}>{category}</option>)}
						</select>
					</label>
					<label>
						<span>State at snapshot</span>
						<select id="state">
							<option value="">All states</option>
							<option value="active">Active at snapshot</option>
							<option value="upcoming">Upcoming</option>
							<option value="closed">Closed</option>
							<option value="undated">Undated</option>
						</select>
					</label>
					<label>
						<span>Completeness</span>
						<select id="level">
							<option value="">All levels</option>
							<option value="1">Level 1 · Catalog</option>
							<option value="2">Level 2 · Evidence map</option>
							<option value="3">Level 3 · Full guide</option>
						</select>
					</label>
				</div>
				<p>Archive snapshot: <time datetime={manifest.inventory.snapshot_date}>{manifest.inventory.snapshot_date}</time>. States, deadlines and metric names describe that snapshot and may differ from official definitions. Published guides state their sourced official metric; check Kaggle for current availability.</p>
				<p id="summary" class="summary" role="status">Browse the available reviewed guides below.</p>
				<button id="retry" type="button" hidden>Retry loading archive</button>
			</section>

			<section id="result-region" aria-labelledby="results-heading" aria-busy="false">
				<h2 id="results-heading" class="visually-hidden">Competition results</h2>
				<script id="guide-records" type="application/json" set:html={JSON.stringify(publishedRows).replaceAll("<", "\\u003c")} />
				<div id="published-guides"><PublishedLibrary /></div>
				<div id="archive-placeholder" class="results" aria-hidden="true">{Array.from({length: 12}, () => <div class="loading-card"><span></span><span></span><span></span></div>)}</div>
				<div id="results" class="results"></div>
				<nav id="pagination" aria-label="Result pages" hidden><button id="previous" type="button">Previous page</button> <span id="page-label"></span> <button id="next" type="button">Next page</button> <button id="last" type="button">Last page</button></nav>
				<noscript><p>The reviewed guides above work without JavaScript. Archive filtering requires JavaScript; you can also <a href="/data/competition-catalog.json">download the complete snapshot</a>.</p></noscript>
			</section>
		</main>

		<script>
			import { createLatestTask } from '../../content/loading-policy.js';
			import { expandCatalog, paginateCatalog } from '../../content/discovery-index.js';
			import {
				getCatalogCardPresentation,
				readCatalogFilters,
				serializeCatalogState,
				filterCatalog,
				usesArchiveView,
			} from '../../content/catalog-policy.js';

			type CatalogCompetition = {
				id: string;
				slug: string;
				title: string;
				subtitle: string;
				competition_url: string;
				category: string;
				record_state: string;
				metric_abbreviation: string;
				metric_name: string;
				completeness_level: string;
				completeness_label: string;
				editorial_status: string;
				guide_slug: string;
				reviewed_by?: string;
				reviewed_at?: string;
				deadline_at: string;
			};

			const query = document.querySelector<HTMLInputElement>('#query')!;
			const category = document.querySelector<HTMLSelectElement>('#category')!;
			const state = document.querySelector<HTMLSelectElement>('#state')!;
			const level = document.querySelector<HTMLSelectElement>('#level')!;
			const summary = document.querySelector<HTMLParagraphElement>('#summary')!;
			const results = document.querySelector<HTMLDivElement>('#results')!;
			const catalogAsset = document.querySelector<HTMLElement>('.catalog-shell')?.dataset.catalogAsset;
		if (!catalogAsset) throw new Error('The catalog asset path is missing.');
			const guideRows: CatalogCompetition[] = JSON.parse(document.querySelector('#guide-records')!.textContent!);
			let competitions: CatalogCompetition[] = [];
			const published = document.querySelector<HTMLElement>('#published-guides')!;
			const region = document.querySelector<HTMLElement>('#result-region')!;
			const retry = document.querySelector<HTMLButtonElement>('#retry')!;
			const pagination = document.querySelector<HTMLElement>('#pagination')!;
			const previous = document.querySelector<HTMLButtonElement>('#previous')!;
			const next = document.querySelector<HTMLButtonElement>('#next')!;
			const last = document.querySelector<HTMLButtonElement>('#last')!;
			let page = Math.max(1, Math.floor(Number(new URLSearchParams(location.search).get('page')) || 1));
			let pages = 1;
			let load: Promise<void> | undefined;

			const escapeHtml = (value: unknown) => {
				const escapedCharacters: Record<string, string> = {
					'&': '&amp;',
					'<': '&lt;',
				'>': '&gt;',
				'"': '&quot;',
				"'": '&#039;',
				};
				return String(value ?? '').replace(/[&<>"']/g, (character) => escapedCharacters[character] ?? character);
			};

			const stateLabels: Record<string, string> = {
				active: 'Active at snapshot',
				upcoming: 'Upcoming',
				closed: 'Closed',
				undated: 'Undated',
			};
			const stateLabel = (value: string) => stateLabels[value] ?? value ?? 'Unknown';

			const dateLabel = (value: string) => {
				if (!value) return '—';
				const date = new Date(value);
				return Number.isNaN(date.getTime())
					? value.slice(0, 10)
					: new Intl.DateTimeFormat('en', { dateStyle: 'medium' }).format(date);
			};

			const updateUrl = (historyMode: 'push' | 'replace' = 'replace') => {
				const search = serializeCatalogState({
					query: query.value,
					category: category.value,
					state: state.value,
					level: level.value,
				}, archiveView, page);
				const effectiveSearch = search;
				const archiveSearch = serializeCatalogState(currentFilters(), true);
				document.querySelector<HTMLAnchorElement>('#archive-view')!.href = `?${archiveSearch}`;
				document.querySelector<HTMLAnchorElement>('#guide-view')!.href = `?${serializeCatalogState(currentFilters(), false)}`;
				document.querySelector('#archive-view')!.setAttribute('aria-current', archiveView ? 'page' : 'false');
				document.querySelector('#guide-view')!.setAttribute('aria-current', archiveView ? 'false' : 'page');
				const next = effectiveSearch
					? `?${effectiveSearch}${window.location.hash}`
					: `${window.location.pathname}${window.location.hash}`;
				if (next !== `${window.location.pathname}${window.location.search}${window.location.hash}`
					&& next !== `${window.location.search}${window.location.hash}`) {
					window.history[historyMode === 'push' ? 'pushState' : 'replaceState']({}, '', next);
				}
			};

			const render = (historyMode: 'push' | 'replace' = 'replace') => {
				const filtered = filterCatalog(archiveView ? competitions : guideRows, currentFilters(), archiveView);
				published.hidden = true;

				const paginationResult = paginateCatalog(filtered, page);
				page = paginationResult.page; pages = paginationResult.pages;
				const {start,visible} = paginationResult;
				summary.textContent = filtered.length ? `Showing ${(start + 1).toLocaleString()}–${(start + visible.length).toLocaleString()} of ${filtered.length.toLocaleString()} ${archiveView ? 'archive matches' : 'available guides'}.` : archiveView ? 'No archive competitions match these filters.' : 'No available guides match these filters.';
				pagination.hidden = pages === 1; previous.disabled = page === 1; next.disabled = last.disabled = page === pages;
				document.querySelector('#page-label')!.textContent = `Page ${page} of ${pages}`;

				if (!visible.length) {
					results.innerHTML = archiveView
						? '<p class="empty">No archive competitions match these filters. Try a broader search.</p>'
						: `<p class="empty">No available guides match these filters. <a href="?${escapeHtml(serializeCatalogState(currentFilters(), true))}">Search all competitions in the archive</a>.</p>`;
					updateUrl(historyMode);
					return;
				}

				if (!archiveView) {
					const visibleRoutes = new Set(visible.map((row: CatalogCompetition) => getCatalogCardPresentation(row).guideHref));
					published.querySelectorAll<HTMLElement>('.library-card').forEach(card => {
						const route = card.querySelector('a')?.getAttribute('href');
						card.hidden = !visibleRoutes.has(route ?? null);
					});
					published.hidden = false;
					results.innerHTML = '';
					updateUrl(historyMode);
					return;
				}

				results.innerHTML = visible.map((competition: CatalogCompetition) => {
					const presentation = getCatalogCardPresentation(competition);
					const guide = presentation.guideHref
						? `<a class="guide-link" href="${escapeHtml(presentation.guideHref)}">Read guide</a>`
						: '<span class="pending">Guide pending</span>';
					const metric = (competition.metric_name || competition.metric_abbreviation || 'Metric not recorded').replace(/([a-z])([A-Z])/g, '$1 $2');
					return `<article class="card">
						<div class="card-topline">
							<span class="pill">Level ${escapeHtml(presentation.completenessLevel)} · ${escapeHtml(presentation.completenessLabel)}</span>
							<span class="state state-${escapeHtml(competition.record_state)}">${escapeHtml(stateLabel(competition.record_state))}</span>
						</div>
						<h3>${escapeHtml(competition.title || competition.slug)}</h3>
						<p class="slug">${escapeHtml(competition.slug)}</p>
						<p>${escapeHtml(competition.subtitle || 'No subtitle recorded in the source snapshot.')}</p>
						<dl>
							<div><dt>Category</dt><dd>${escapeHtml(competition.category || 'Uncategorized')}</dd></div>
							<div><dt>Metric at snapshot</dt><dd>${escapeHtml(metric)}</dd></div>
							<div><dt>Deadline</dt><dd>${escapeHtml(dateLabel(competition.deadline_at))}</dd></div>
						</dl>
						<div class="card-links">
							<a href="${escapeHtml(competition.competition_url)}" target="_blank" rel="noreferrer">Open on Kaggle ↗</a>
							${guide}
						</div>
					</article>`;
				}).join('');
				updateUrl(historyMode);
			};

			const currentFilters = () => ({ query: query.value, category: category.value, state: state.value, level: level.value });
			const filters = readCatalogFilters(window.location.search);
			let archiveView = usesArchiveView(window.location.search);
			query.value = filters.query;
			category.value = filters.category;
			state.value = filters.state;
			level.value = filters.level;
			const updates = createLatestTask();
			function updateResults(historyMode: 'push' | 'replace' = 'replace') {
				if (archiveView) {
					updateUrl(historyMode);
					return ensureArchive();
				}
				updates.invalidate();
				region.setAttribute('aria-busy', 'false');
				retry.hidden = true;
				delete document.documentElement.dataset.archivePending;
				render(historyMode);
			}
			async function ensureArchive() {
				await updates.run(async () => {
					if (!load) {
						load = fetch(catalogAsset!)
							.then(response => { if (!response.ok) throw new Error('Archive unavailable'); return response.json(); })
							.then(data => {
								competitions = expandCatalog(data) as CatalogCompetition[];
								const priority: Record<string,number> = {'Getting Started':0, Featured:1, Research:2};
								competitions.sort((a,b) => (priority[a.category] ?? 3) - (priority[b.category] ?? 3) || b.deadline_at.localeCompare(a.deadline_at) || Number(a.id) - Number(b.id));
							}).catch(error => { load = undefined; throw error; });
					}
					await load;
				}, {
					pending: () => { region.setAttribute('aria-busy', 'true'); summary.textContent = 'Loading archive…'; retry.hidden = true; },
					complete: () => { render(); published.hidden = true; },
					failed: () => { summary.textContent = 'The archive could not be loaded. Your current results are still available. Try again.'; retry.hidden = false; },
					settled: () => { region.setAttribute('aria-busy', 'false'); delete document.documentElement.dataset.archivePending; },
				});
			}
			let timer: ReturnType<typeof setTimeout>;
			query.addEventListener('input', () => {
				updates.invalidate(); clearTimeout(timer); page = 1;
				timer = setTimeout(() => updateResults('push'), 180);
			});
			[category, state, level].forEach(control => control.addEventListener('change', () => {
				clearTimeout(timer); page = 1; updateResults('push');
			}));
			retry.addEventListener('click', () => { clearTimeout(timer); updateResults('push'); });
			previous.addEventListener('click', () => { clearTimeout(timer); updates.invalidate(); page--; render('push'); });
			next.addEventListener('click', () => { clearTimeout(timer); updates.invalidate(); page++; render('push'); });
			last.addEventListener('click', () => { clearTimeout(timer); updates.invalidate(); page = pages; render('push'); });
			window.addEventListener('popstate', () => {
				clearTimeout(timer); updates.invalidate();
				const restored = readCatalogFilters(window.location.search);
				query.value = restored.query; category.value = restored.category;
				state.value = restored.state; level.value = restored.level;
				archiveView = usesArchiveView(window.location.search);
				page = Math.max(1, Math.floor(Number(new URLSearchParams(location.search).get('page')) || 1));
				updateResults();
			});
			updateResults();

		</script>
	</body>
</html>

<style is:global>
	:root {
		font-family: system-ui, sans-serif;
		color: #1c1b22;
		background: #f7f7f8;
	}
	* { box-sizing: border-box; }
	body { margin: 0; }
	.catalog-shell { max-width: 1180px; margin: 0 auto; padding: 2rem 1.25rem 5rem; }
	.catalog-header { max-width: 760px; padding: 1rem 0 2.5rem; }
	.back-link, a { color: #5b21b6; }
	.back-link { font-weight: 650; text-decoration: none; }
	.eyebrow { margin: 3rem 0 .5rem; color: #6b21a8; font-size: .78rem; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; }
	h1 { margin: 0; font-size: clamp(2.5rem, 6vw, 4.75rem); letter-spacing: -.055em; line-height: .98; }
	h2 { margin: 0; font-size: 1.35rem; }
	.lede { color: #55525f; font-size: 1.1rem; line-height: 1.65; }
	.controls { margin-bottom: 2rem; padding: 1.25rem; border: 1px solid #e4e0ea; border-radius: 1rem; background: white; box-shadow: 0 10px 30px #2d174d0d; }
	.control-grid { display: grid; grid-template-columns: 2fr repeat(3, 1fr); gap: 1rem; margin-top: 1rem; }
	label span { display: block; margin-bottom: .4rem; color: #625e6b; font-size: .82rem; font-weight: 700; }
	input, select { width: 100%; min-height: 2.65rem; padding: .6rem .7rem; border: 1px solid #cfc9d8; border-radius: .55rem; background: white; color: inherit; font: inherit; }
	input:focus, select:focus { outline: 3px solid #c4b5fd; outline-offset: 1px; }
	.summary { margin: 1rem 0 0; color: #625e6b; font-size: .9rem; }
	.results { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr)); gap: 1rem; }
	.card { display: flex; min-height: 295px; flex-direction: column; padding: 1.15rem; border: 1px solid #e4e0ea; border-radius: 1rem; background: white; }
	.card-topline, .card-links { display: flex; align-items: center; justify-content: space-between; gap: .75rem; }
	.card-topline { color: #625e6b; font-size: .78rem; }
	.pill, .state { border-radius: 999px; padding: .25rem .55rem; font-weight: 700; }
	.pill { background: #f0eafa; color: #5b21b6; }
	.state { background: #f1f0f3; }
	.state-active { background: #dcfce7; color: #166534; }
	.state-upcoming { background: #fef3c7; color: #92400e; }
	.card h3 { margin: 1.1rem 0 .15rem; font-size: 1.15rem; line-height: 1.25; }
	.card p { color: #625e6b; line-height: 1.45; }
	.card .slug { margin: 0; color: #8b8495; font-family: ui-monospace, monospace; font-size: .78rem; overflow-wrap: anywhere; }
	dl { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: .65rem; margin: auto 0 1rem; }
	dl > div { min-width: 0; }
	dt { color: #8b8495; font-size: .72rem; }
	dd { min-width: 0; margin: .2rem 0 0; font-size: .82rem; overflow-wrap:anywhere; }
	.card-links { justify-content: flex-start; font-size: .86rem; font-weight: 700; }
	.guide-link { margin-left: auto; }
	.pending { color: #8b8495; font-size: .82rem; font-weight: 600; }
	.empty { padding: 2rem; border: 1px dashed #cfc9d8; border-radius: 1rem; color: #625e6b; text-align: center; }
	.visually-hidden { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; clip-path: inset(50%); }
	@media (max-width: 800px) { .control-grid { grid-template-columns: 1fr 1fr; } }
	@media (max-width: 520px) { .catalog-shell { padding-inline: .9rem; } .control-grid { grid-template-columns: 1fr; } dl { gap: .35rem; } }
</style>

<style is:global> #pagination { margin-top:1.5rem; } #pagination button { padding:.65rem; font:inherit; } #pagination[hidden], #published-guides[hidden], #published-guides .library-card[hidden] { display:none; } </style>

<style is:global>
  #archive-placeholder { display:none; }
  :root[data-archive-pending] #archive-placeholder { display:grid; }
  :root[data-archive-pending] #published-guides { display:none; }
  .loading-card { min-height:295px; box-sizing:border-box; padding:1.25rem; border:1px solid #d8d0e2; border-radius:.75rem; background:#f8f6fb; }
  .loading-card span { display:block; height:1rem; margin:1rem 0; border-radius:.3rem; background:#e4dfec; }
  .loading-card span:first-child { width:65%; height:1.5rem; }
  .loading-card span:last-child { width:45%; }
  #summary { min-height:3em; }
  #result-region[aria-busy="true"] { opacity:.75; }
  #result-region { transition:opacity 140ms ease-out; }
  :root[data-theme="dark"] .loading-card { background:#24232b; border-color:#45414e; }
  :root[data-theme="dark"] .loading-card span { background:#45414e; }
  @media(prefers-reduced-motion:reduce) { #result-region { transition:none; } }
</style>
<noscript><style>:root[data-archive-pending] #published-guides{display:block}#archive-placeholder{display:none!important}</style></noscript>
