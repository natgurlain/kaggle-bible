---
import SiteNav from '../components/SiteNav.astro';
import PublishedLibrary from '../components/PublishedLibrary.astro';
import { learningLibrary } from '../content/learning-library';
const {guideCards}=await learningLibrary();
const cardsByPath=Object.fromEntries(guideCards.map(card=>[card.guide_href,card]));
---
<!doctype html><html lang="en"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width"/><title>Search · Kaggle Bible</title><meta name="robots" content="noindex"/></head>
<body><SiteNav/><main data-guide-cards={JSON.stringify(cardsByPath)} id="main-content" tabindex="-1"><h1>Search the learning library</h1><label for="library-query">Find a guide, practice, or lesson</label><input id="library-query" type="search" autocomplete="off"/><p id="search-status" role="status">Enter a topic to search.</p><button id="search-retry" type="button" hidden>Retry search</button><ul id="search-results" aria-busy="false"></ul><noscript><h2>Published guide projects</h2><PublishedLibrary /></noscript></main></body></html>
<script>
  import { renderGuideCardDetails } from '../content/guide-card-policy.js';
  import { createLatestTask } from '../content/loading-policy.js';
  const input = document.querySelector<HTMLInputElement>('#library-query')!;
  const status = document.querySelector<HTMLElement>('#search-status')!;
  const results = document.querySelector<HTMLElement>('#search-results')!;
  const retry = document.querySelector<HTMLButtonElement>('#search-retry')!;
  type SearchPage = { url: string; meta: { title: string }; excerpt: string };
  type SearchResult = { data: () => Promise<SearchPage> };
  const guideCards = JSON.parse(document.querySelector<HTMLElement>('[data-guide-cards]')!.dataset.guideCards!);
  const updates = createLatestTask();
  async function search() {
    const query = input.value.trim();
    history.replaceState({}, '', query ? `?q=${encodeURIComponent(query)}` : location.pathname);
    if (!query) {
      updates.invalidate(); results.replaceChildren(); results.setAttribute('aria-busy', 'false');
      status.textContent = 'Enter a topic to search.'; retry.hidden = true; return;
    }
    await updates.run(async () => {
      const moduleUrl = '/pagefind/pagefind.js';
      const pagefind = await import(/* @vite-ignore */ moduleUrl);
      const found: { results: SearchResult[] } = await pagefind.search(query);
      const pages = await Promise.all(found.results.slice(0, 20).map(result => result.data()));
      return { found, pages };
    }, {
      pending: () => { status.textContent = 'Searching…'; results.setAttribute('aria-busy', 'true'); retry.hidden = true; },
      complete: ({ found, pages }) => {
        const items = pages.map(page => {
          const item = document.createElement('li');
          const link = document.createElement('a');
          link.href = page.url; link.textContent = page.meta.title;
          const excerpt = document.createElement('p'); excerpt.textContent = page.excerpt.replace(/<[^>]*>/g, '');
          item.append(link, excerpt);
          const path = new URL(page.url, location.origin).pathname.replace(/\/?$/, '/');
          if(guideCards[path]) {
            const details=document.createElement('div'); details.innerHTML=renderGuideCardDetails(guideCards[path]); item.append(details);
          }
          return item;
        });
        results.replaceChildren(...items);
        status.textContent = `${found.results.length} results${found.results.length > 20 ? '; showing the first 20. Refine your search for more.' : '.'}`;
      },
      failed: () => { status.textContent = 'Search is unavailable. Your current results are still available. Try again.'; retry.hidden = false; },
      settled: () => results.setAttribute('aria-busy', 'false'),
    });
  }
  input.value = new URLSearchParams(location.search).get('q') || '';
  let timer: ReturnType<typeof setTimeout>;
  input.addEventListener('input', () => { updates.invalidate(); clearTimeout(timer); timer = setTimeout(search, 150); });
  retry.addEventListener('click', () => {
    clearTimeout(timer);
    const query = input.value.trim();
    history.replaceState({}, '', query ? `?q=${encodeURIComponent(query)}` : location.pathname);
    location.reload();
  });
  search();
</script>
<style>main{max-width:850px;margin:2rem auto;padding:0 1.2rem;font-family:system-ui;line-height:1.6}input{display:block;width:100%;padding:.8rem;margin:.6rem 0;font:inherit}li{padding:1rem 0;overflow-wrap:anywhere} :global(.guide-learning-details){line-height:1.55} :global(.guide-projects){padding-left:1.2rem}a{color:#56309d}</style>

<style>
  #search-status { min-height:3em; }
  #search-results { min-height:24rem; padding-left:1.5rem; transition:opacity 140ms ease-out; }
  #search-results[aria-busy="true"] { opacity:.65; }
  #search-results[aria-busy="true"]:empty::before { content:""; display:block; height:20rem; border-radius:.5rem; background:repeating-linear-gradient(to bottom,#e4dfec 0 1rem,transparent 1rem 3rem); }
  :global(:root[data-theme="dark"]) #search-results[aria-busy="true"]:empty::before { background:repeating-linear-gradient(to bottom,#45414e 0 1rem,transparent 1rem 3rem); }
  input { box-sizing:border-box; }
  @media(prefers-reduced-motion:reduce) { #search-results { transition:none; } }
</style>
