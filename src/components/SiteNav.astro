<header class="site-nav" data-pagefind-ignore>
  <a class="site-brand" href="/">Kaggle Bible</a>
  <nav aria-label="Main">
    <a href="/competitions/">Guides</a><a href="/path/">Learning path</a>
    <a href="/practices/">Practices</a><a href="/contribute/">Contribute</a><a href="/search/">Search</a>
  </nav>
  <label>Theme <select id="site-theme"><option value="">Auto</option><option value="light">Light</option><option value="dark">Dark</option></select></label>
</header>
<script is:inline>
  (() => {
    const select = document.getElementById('site-theme');
    const media = window.matchMedia('(prefers-color-scheme: dark)');
    let preference = '';
    try { preference = localStorage.getItem('starlight-theme') || ''; } catch {}
    if (!['light', 'dark'].includes(preference)) preference = '';
    select.value = preference;
    const apply = () => document.documentElement.dataset.theme = preference || (media.matches ? 'dark' : 'light');
    select.addEventListener('change', () => {
      preference = select.value;
      try { localStorage.setItem('starlight-theme', preference); } catch {}
      apply();
    });
    media.addEventListener('change', apply);
    apply();
  })();
</script>
<style is:global>
  .site-nav { display:flex; flex-wrap:wrap; align-items:center; gap:1rem; padding:1rem max(1rem,calc((100% - 1120px)/2)); border-bottom:1px solid #d8d0e2; background:#fff; }
  .site-brand { font-weight:800; text-decoration:none; }
  .site-nav nav { display:flex; flex-wrap:wrap; gap:.9rem; }
  .site-nav label { margin-left:auto; font-size:.85rem; }
  .site-nav select { min-height:2rem; width:auto; padding:.3rem; font:inherit; }
  :is(a,button,input,select,summary):focus-visible { outline:3px solid #8b5cf6; outline-offset:3px; }
  :root[data-theme="dark"] { color-scheme:dark; background:#17171b; color:#e8e5ed; }
  :root[data-theme="dark"] body { background:#17171b; color:#e8e5ed; }
  :root[data-theme="dark"] :is(.site-nav,.panel,.solution-card,.evidence-card,.guide-body,.practice-content,.content-section,.controls,.card,.quick-start) { background:#24232b; border-color:#45414e; color:#e8e5ed; }
  :root[data-theme="dark"] :is(p,dd,li,dt,.lede,.review-note,.breadcrumbs,.summary,.prose p,.prose li,.solution-card p,.practice-list span) { color:#c8c3d1; }
  :root[data-theme="dark"] :is(a,.official-link) { color:#c4b5fd; }
  :root[data-theme="dark"] :is(input,select,.unknown-note,.rank,.evidence-section,.level-badge) { background:#302c3a; color:#e8e5ed; border-color:#635775; }
  :root[data-theme="dark"] .site-nav a:hover { color:#e4dbff; }
  @media(max-width:520px) { .site-nav { gap:.75rem; } .site-nav nav { order:3; width:100%; font-size:.85rem; gap:.8rem; } }
</style>
