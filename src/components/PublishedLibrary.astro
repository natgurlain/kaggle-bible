---
import { learningLibrary } from '../content/learning-library';
import { renderGuideCardDetails } from '../content/guide-card-policy.js';
const { kind = 'guides' } = Astro.props;
const library = await learningLibrary();
const entries = kind === 'practices' ? library.practices : library.guides;

---
<div class="library-grid">
  {entries.map(entry => <article class="library-card">
    <h3><a href={`/${kind === 'practices' ? 'practices' : 'competitions'}/${entry.data.slug}/`}>{entry.data.title}</a></h3>
    <p>{entry.data.summary}</p>
    {"metrics" in entry.data && <p><strong>Official metric:</strong> {entry.data.metrics.map(metric => metric.name).join(", ")}</p>}
    {kind !== 'practices' && <Fragment set:html={renderGuideCardDetails(library.guideCards.find(card=>card.id===entry.id))} />}
    <a href={`/${kind === 'practices' ? 'practices' : 'competitions'}/${entry.data.slug}/`}>Read {kind === 'practices' ? 'practice' : 'guide'} →</a>
  </article>)}
</div>
<style>
  .library-grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(min(100%,280px),1fr)); gap:1rem; }
  .library-card { padding:1.25rem; border:1px solid var(--sl-color-gray-5, #cfc9d8); border-radius:.75rem; }
  .library-card h3 { margin:0; font-size:1.15rem; }
  .library-card { line-height:1.55; overflow-wrap:anywhere; }
  :global(.guide-projects) { padding-left:1.2rem; }
  .library-card p { margin:.75rem 0; }
</style>
